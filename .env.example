# Ports (Host)
WEB_PORT=8080
API_PORT=3000

# DB (compose service name: db)
DATABASE_URL=postgresql://masterpoint:masterpoint@db:5432/masterpoint?schema=public

# Auth
JWT_SECRET=please_change_to_a_long_random_secret_min_24_chars
JWT_EXPIRES_IN=12h

# Bootstrap (wird nur genutzt, wenn DB noch keine User hat)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_TENANT_ID=t_default
INITIAL_TENANT_NAME=Default Tenant

# Business rules (optional)
OPENING_HOURS_START=08:00
OPENING_HOURS_END=20:00
MIN_GAP_MINUTES=0

# Automations (optional)
AUTOMATIONS_ENABLED=true
REMINDER_CRON=*/5 * * * *
REMINDER_LEAD_MINUTES=60
NO_SHOW_CRON=*/10 * * * *
NO_SHOW_GRACE_MINUTES=30
