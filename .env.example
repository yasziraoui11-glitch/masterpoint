# Ports (Host)
WEB_PORT=8080
API_PORT=3000

# Database (Container-Netz: Hostname "db")
DATABASE_URL=postgresql://masterpoint:masterpoint@db:5432/masterpoint?schema=public

# JWT (min. 24 Zeichen)
JWT_SECRET=please_change_this_to_a_long_random_secret_32_chars_min
JWT_EXPIRES_IN=12h

# Initial bootstrap admin (wird nur angelegt, wenn noch kein User existiert)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin123

# Initial tenant
INITIAL_TENANT_ID=t_default
INITIAL_TENANT_NAME=Default Tenant

# Business rules
OPENING_HOURS_START=08:00
OPENING_HOURS_END=20:00
MIN_GAP_MINUTES=0

# Worker automations
AUTOMATIONS_ENABLED=true
REMINDER_CRON=*/5 * * * *
REMINDER_LEAD_MINUTES=60
NO_SHOW_CRON=*/10 * * * *
NO_SHOW_GRACE_MINUTES=30
