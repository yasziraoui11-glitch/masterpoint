generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  users     User[]
  kunden    Kunde[]
  services  Service[]
  termine   Termin[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  role         Role     @default(admin)
  createdAt    DateTime @default(now())
  audit        AuditEvent[]
}

enum Role {
  admin
  mitarbeiter
}

model Kunde {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  telefon   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  termine   Termin[]
  @@index([tenantId])
}

model Service {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  dauerMinuten Int
  preis        Float
  kategorie    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  termine      Termin[]
  @@index([tenantId])
}

enum TerminStatus {
  planned
  confirmed
  cancelled
  completed
  no_show
}

model Termin {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  datum         String
  zeit          String
  endzeit       String?
  notiz         String?
  status        TerminStatus @default(planned)
  reminderSentAt DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  completedAt   DateTime?
  noShowAt      DateTime?
  kundeId       String?
  kunde         Kunde?      @relation(fields: [kundeId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([tenantId, datum])
}

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  data      Json?
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}
